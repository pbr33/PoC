# ════════════════════════════════════════════════════════════════════════
#  BELLA — Server Setup: copy this to .streamlit/secrets.toml and fill in
#  your real values.  Alternatively set the equivalent env vars (see below).
# ════════════════════════════════════════════════════════════════════════

# ── Microsoft Entra ID (Azure AD SSO) ─────────────────────────────────
AAD_CLIENT_ID     = "your-azure-ad-app-client-id"
AAD_TENANT_ID     = "your-azure-ad-tenant-id"
AAD_CLIENT_SECRET = "your-azure-ad-client-secret"

# Set this to the PUBLIC URL of the server (must match Azure AD Redirect URI)
# Examples:
#   http://20.62.9.198:8501   ← Azure VM with public IP
#   https://bella.yourcompany.com  ← custom domain
APP_BASE_URL = "http://YOUR_SERVER_IP:8501"
